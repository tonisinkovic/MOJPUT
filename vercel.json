{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/MOJPUT",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/MOJPUT/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/MOJPUT/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
