# Server
PORT=3000
JWT_SECRET=promijeni-me-na-sigurnu-vrijednost

# Javni URL frontenda — GitHub Pages (HTTPS)
APP_ORIGIN=https://tonisinkovic.github.io/MOJPUT

# (Opcionalno) Javni HTTPS front (ne localhost) — za redirect nakon potvrde i za link u mailu ako nije default.
# APP_ORIGIN_PUBLIC=https://tonisinkovic.github.io/MOJPUT

# Link u mailu za potvrdu = GitHub Pages (ili EMAIL_VERIFY_PAGE_BASE). Ne stavljaj localhost.
# EMAIL_VERIFY_PAGE_BASE=https://tonisinkovic.github.io/MOJPUT

# Javni Node API (VITE_API_URL u buildu za GitHub Pages — stranica zove API za potvrdu).
# API_PUBLIC_URL=https://tvoj-servis.onrender.com

# SMTP — registracija šalje mail za potvrdu (Gmail: app lozinka, 2FA)
# Pošiljatelj mora biti isti email kao SMTP_USER (npr. MojPut <tvoj@gmail.com>)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=MojPut <your-email@gmail.com>

# Bez SMTP-a koristi se Ethereal (testni inbox) – link za pregled se prikaže u UI

# Produkcijski build (vidi .env.production): API mora biti na drugom hostu od github.io
# VITE_API_URL=https://tvoj-node-backend.example.com
