# Server
PORT=3000
JWT_SECRET=promijeni-me-na-sigurnu-vrijednost

# Javni origin frontenda (GitHub Pages) — bez /MOJPUT. Link u mailu: ${APP_ORIGIN}/MOJPUT/verify?token=...
# Na Renderu i u produkciji APP_ORIGIN mora biti HTTPS (primjer ispod). Kod ne postavlja localhost sam od sebe.
# Samo na svom računalu za test možeš u vlastitom .env (ne commitaj) staviti npr. http://localhost:8080 — to ne ide na Render.
# Ako lokalno šalješ pravi mail i želiš localhost u linku: ALLOW_LOCALHOST_IN_MAIL=1 (inače se u mailu uvijek koristi HTTPS Pages).
# Ako treba ručno forsirati link u mailu: FORCE_MAIL_APP_ORIGIN=https://tvoj-user.github.io
# PUBLIC_APP_ORIGIN=https://tvoj-user.github.io
APP_ORIGIN=https://tonisinkovic.github.io

# Javni Node API (VITE_API_URL u buildu za GitHub Pages — stranica zove API za potvrdu).
# API_PUBLIC_URL=https://tvoj-servis.onrender.com

# SMTP — registracija / ponovno slanje potvrde (bez ovoga u dev: Ethereal testni inbox)
#
# Gmail — greška «535 / Username and Password not accepted» = kriva SMTP_PASS.
#   • Mora biti «Lozinka aplikacije» (16 znakova), NE obična lozinka za google.com
#   • Google račun → Sigurnost → dvostruka provjera UKLJUČENA → Lozinke aplikacija → Pošta
#   • Zalijepi 16 znakova u SMTP_PASS bez razmaka (ili ih kod učitavanja uklanjamo)
#   • SMTP_USER = točan puni Gmail (npr. ime@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=MojPut <your-email@gmail.com>

# Za lokalni test BEZ pravog maila: zakomentiraj ili obriši sve SMTP_* — koristi se Ethereal.

# Produkcijski build: vidi .env.production (zadano https://mojput-api.onrender.com).
# VITE_API_URL=https://tvoj-node-backend.example.com
