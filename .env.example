# NODE_ENV=production u lokalnom .env je u redu dok nisi na Renderu.

# Server (Node API — PORT)
# Vite u «npm run dev» prosljeđuje /api na http://127.0.0.1:3000
# Bez pokrenutog API-ja proxy javlja grešku na npr. /api/auth/me — koristi «npm run dev:full» ili u drugom terminalu: node server.cjs
PORT=3000
JWT_SECRET=promijeni-me-na-sigurnu-vrijednost

# App baza (korisnici, forum, potvrda emaila, …). Lokalno: prazno → SQLite u data/mojput.db.
# Produkcija (Render bez plaćenog diska): besplatni PostgreSQL (Neon / Supabase) — connection string:
# MOJPUT_DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Ako je postavljen, API koristi PostgreSQL umjesto SQLite datoteke (podaci ostaju nakon redeploya).
# MOJPUT_DATA_DIR=… — samo za lokalni/SQLite put; s MOJPUT_DATABASE_URL nije potreban.

# Javni origin frontenda (GitHub Pages) — bez /MOJPUT. CORS / redirect nakon potvrde; NE koristi se za link u mailu.
# Na Renderu APP_ORIGIN = HTTPS (primjer ispod). Za fork: PUBLIC_APP_ORIGIN / FORCE_MAIL_APP_ORIGIN po potrebi.
APP_ORIGIN=https://tonisinkovic.github.io

# Dodatni dopušteni Origin-i za CORS (zarezom), npr. drugi GitHub Pages fork — https://user.github.io
# CORS_ALLOWED_ORIGINS=https://drugi.github.io

# Potvrda računa: korisnik dobije 6-znamenkasti kod u mailu i upiše ga na {APP_ORIGIN}/MOJPUT/verify
# Lokalno: u mailu je link na frontend (Vite). API_PUBLIC_URL u .env
#   služi samo za Vite build — za potvrdu se lokalno IGNORIRA (inače link ide na Render bez tvog tokena).
# Na Renderu: API_PUBLIC_URL=https://mojput.onrender.com (vidi render.yaml)
# Za tunel (mobitel izvan LAN-a): MAIL_VERIFY_API_BASE=https://tvoj-tunel.example.com
# Lokalno zadano: http://127.0.0.1:PORT. Mobitel na istom Wi‑Fi: MAIL_USE_LAN_IP=1. Ručno: MAIL_API_HOST=192.168.1.10
# Ako lokalno slučajno imaš RENDER=true u .env, a baza je lokalna: MAIL_VERIFY_API_BASE=http://127.0.0.1:3000
# VITE_API_URL u produkcijskom buildu (GitHub Pages) = isti host kao gore.

# Resend (preporučeno na Renderu) — registracija bez Gmail SMTP problema. https://resend.com
# Ako je postavljeno RESEND_API_KEY, API šalje mail preko Resenda i NE koristi SMTP_* za potvrdu.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM — samo na backendu (Render), ne u GitHub Pages buildu. Opcionalno: prazno = MojPut <onboarding@resend.dev>.
# Ako vidiš grešku o «from»: ukloni krivu vrijednost s Rendera ili postavi točno: MojPut <onboarding@resend.dev>
# Svoja adresa = samo ako je domen verificiran u Resendu (resend.com/domains), npr. RESEND_FROM=MojPut <noreply@tvojdomen.hr>

# Ako SMTP ne radi lokalno (npr. getaddrinfo ENOTFOUND smtp.gmail.com — DNS/VPN), u devu API automatski
# pada na Ethereal testni inbox (URL u terminalu). Na Renderu ostavi Resend ili ispravan SMTP.
# Ručno forsiraj Ethereal i kad imaš SMTP_*: SMTP_FALLBACK_ETHEREAL=1
# SMTP_FALLBACK_ETHEREAL=1

# Obavijest na mail kad netko pošalje povratnu informaciju (zadano mojputhr@gmail.com)
# FEEDBACK_NOTIFY_EMAIL=mojputhr@gmail.com

# Tim — pristup /MOJPUT/tim i GET /api/admin/stats (email mora biti potvrđen i naveden ovdje; više adresa odvoj zarezom)
# ADMIN_EMAILS=mojputhr@gmail.com,drugi@example.com

# SMTP — samo ako nema Resend; registracija / ponovno slanje potvrde (bez SMTP i Resend u dev: Ethereal)
#
# Gmail — greška «535 / Username and Password not accepted» = kriva SMTP_PASS.
#   • Mora biti «Lozinka aplikacije» (16 znakova), NE obična lozinka za google.com
#   • Google račun → Sigurnost → dvostruka provjera UKLJUČENA → Lozinke aplikacija → Pošta
#   • Zalijepi 16 znakova u SMTP_PASS bez razmaka (ili ih kod učitavanja uklanjamo)
#   • SMTP_USER = točan puni Gmail (npr. ime@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=MojPut <your-email@gmail.com>

# Za lokalni test BEZ pravog maila: zakomentiraj ili obriši sve SMTP_* — koristi se Ethereal.

# OpenAI — chatbot Dražen (/api/chat). Bez ključa koristi se samo lokalni odgovor iz baze.
# Ključ: https://platform.openai.com/api-keys — NIKAD ne commitaj .env
# OPENAI_API_KEY=sk-proj-...
# Zadano: gpt-4o-mini (jeftinije). Za jači model: OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_CHAT_MODEL=gpt-4o-mini
# Štednja kredita (opcionalno): max. duljina odgovora i koliko zadnjih poruka šaljemo u API
# OPENAI_MAX_OUTPUT_TOKENS=1200
# OPENAI_CHAT_HISTORY_MAX=14

# Chatbot: besplatne poruke po prijavljenom korisniku i danu (zadano 12)
# CHAT_FREE_DAILY_LIMIT=12

# Produkcijski build: vidi .env.production (zadano https://mojput.onrender.com).
# VITE_API_URL=https://tvoj-node-backend.example.com
# Google Analytics 4 Measurement ID (frontend)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional GDPR gate: set true to require localStorage analytics_consent=granted
# VITE_ANALYTICS_REQUIRE_CONSENT=false

# Vercel / statički hosting na korijenu domene (ne GitHub Pages /MOJPUT/):
# Ako prilagođena domena daje 404: u Project Settings mora biti Output Directory = dist (vercel.json to već forsira),
# VITE_BASE_PATH=/, i u pregledniku koristi https://domena/ — ne https://domena/MOJPUT/ (stari Pages put).
# U Vercel Environment Variables postavi VITE_BASE_PATH=/ (build asseti i rute na /).
# Na Renderu (API, mailovi): APP_ORIGIN=https://tvoja-domena.hr i FRONTEND_AT_ROOT=1
# (linkovi na /verify i /prijava umjesto /MOJPUT/...).
# FRONTEND_PATH_PREFIX= — alternativa: eksplicitni segment (npr. app) ako nije korijen ni MOJPUT.
