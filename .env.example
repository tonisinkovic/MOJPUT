# Server
PORT=3000
JWT_SECRET=promijeni-me-na-sigurnu-vrijednost

# URL aplikacije (za link za potvrdu emaila u mailu)
# Lokalno: http://localhost:8080/MOJPUT
# Produkcija: https://tonisinkovic.github.io/MOJPUT
APP_ORIGIN=http://localhost:8080/MOJPUT

# SMTP za slanje emaila s linkom za potvrdu računa
# Bez SMTP-a registracija neće raditi (REQUIRE_SMTP_FOR_VERIFY=true)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
MAIL_FROM=MojPut <noreply@example.com>

# Bez SMTP-a koristi se Ethereal (testni inbox) – link za pregled se prikaže u UI

# Frontend (opcionalno): URL API-ja u produkciji kad je backend na drugom domenu
# VITE_API_URL=https://tvoj-api.example.com
